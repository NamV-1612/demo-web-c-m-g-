            </div>
            
            <Form.Item name="password" rules={[
              { required: true, message: 'Vui lòng nhập mật khẩu!' },
              ...(activeTab === '2' ? [{ pattern: /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,}$/, message: 'Mật khẩu phải từ 8 ký tự, gồm chữ hoa, thường và số!' } as any] : [])

/* ========================================================= */
/* PREMIUM GLOBAL MODAL OVERRIDES (REMOVING DEFAULT LOOK)    */
/* ========================================================= */

.ant-modal {
  padding-bottom: 0;
  
  .ant-modal-content {
    border-radius: 20px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(0,0,0,0.05);
    overflow: hidden;
    backdrop-filter: blur(10px);
  }

  .ant-modal-header {
    border-bottom: 1px solid rgba(0,0,0,0.06);
    padding: 24px 32px 16px;
    background: #fff;
    border-radius: 20px 20px 0 0;

    .ant-modal-title {
      font-weight: 700;
      font-size: 20px;
      color: #1f1f1f;
      letter-spacing: -0.5px;
      font-family: 'Inter', sans-serif;
    }
  }

  .ant-modal-close {
    top: 20px;
    right: 24px;
    color: #8c8c8c;
    transition: all 0.3s ease;
    border-radius: 50%;
    background: #f5f5f5;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;

    &:hover {
      color: #ff4d4f;
      background: #fff1f0;
      transform: rotate(90deg);
    }

    .ant-modal-close-x {
      width: 32px;
      height: 32px;
      line-height: 32px;
      font-size: 14px;
    }
  }

  .ant-modal-body {
    padding: 24px 32px;
    font-size: 15px;
  }

  .ant-modal-footer {
    border-top: 1px solid rgba(0,0,0,0.06);
    padding: 16px 32px 24px;
    background: #fafafa;
    border-radius: 0 0 20px 20px;

    .ant-btn {
      border-radius: 10px;
      height: 42px;
      padding: 0 24px;
      font-weight: 600;
      transition: all 0.2s;

      &.ant-btn-default {
        border-color: #d9d9d9;
        &:hover {
          color: #BA1A21;
          border-color: #BA1A21;
          background: transparent;
        }
      }

      &.ant-btn-primary {
        background: linear-gradient(135deg, #ff9c3a, #BA1A21);
        border: none;
        box-shadow: 0 4px 10px rgba(186, 26, 33, 0.3);

        &:hover {
          transform: translateY(-2px);
          box-shadow: 0 6px 15px rgba(186, 26, 33, 0.4);
          background: linear-gradient(135deg, #ff7875, #ffc069);
        }
      }
    }
  }
}

/* For confirm modals (Modal.confirm) */
.ant-modal-confirm {
  .ant-modal-body {
    padding: 32px;
  }
  .ant-modal-confirm-title {
    font-weight: 700;
    font-size: 18px;
    color: #1f1f1f;
  }
  .ant-modal-confirm-content {
    margin-top: 12px;
    color: #595959;
    font-size: 15px;
    line-height: 1.6;
  }
  .ant-modal-confirm-btns {
    margin-top: 32px;
    
    .ant-btn {
      border-radius: 10px;
      height: 40px;
      padding: 0 20px;
      font-weight: 600;
      
      &.ant-btn-primary {
        background: linear-gradient(135deg, #ff4d4f, #BA1A21);
        border: none;
        box-shadow: 0 4px 10px rgba(186, 26, 33, 0.3);
      }
    }
  }
}

/* ========================================================= */
/* PREMIUM FORM & INPUT OVERRIDES                            */
/* ========================================================= */

.ant-input,
.ant-input-password,
.ant-input-number,
.ant-select:not(.ant-select-customize-input) .ant-select-selector,
.ant-picker {
  border-radius: 8px;
  background-color: #f5f5f5;
  transition: all 0.3s cubic-bezier(0.645, 0.045, 0.355, 1);
  box-shadow: none;
}

.ant-input-affix-wrapper {
  border-radius: 8px;
  background-color: #f5f5f5;
  transition: all 0.3s cubic-bezier(0.645, 0.045, 0.355, 1);
}

.ant-input:hover,
.ant-input-number:hover,
.ant-select:not(.ant-select-customize-input) .ant-select-selector:hover,
.ant-picker:hover,
.ant-input-affix-wrapper:hover {
  border-color: var(--primary-color);
}

.ant-input:focus,
.ant-input-focused,
.ant-input-number-focused,
.ant-select-focused:not(.ant-select-customize-input) .ant-select-selector,
.ant-picker-focused,
.ant-input-affix-wrapper:focus,
.ant-input-affix-wrapper-focused {
  border-color: var(--primary-color) !important;
  box-shadow: 0 0 0 3px rgba(186, 26, 33, 0.15) !important;
}

/* ========================================================= */
/* PREMIUM BUTTON OVERRIDES                                  */
/* ========================================================= */

.ant-btn {
  border-radius: 8px;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;

  &.ant-btn-primary {
    background: linear-gradient(135deg, #d32f2f, #99151b);
    border: none;
    box-shadow: 0 4px 10px rgba(186, 26, 33, 0.35);
    color: #fff;

    &:hover, &:focus {
      background: linear-gradient(135deg, #e53935, #ba1a21);
      box-shadow: 0 6px 15px rgba(186, 26, 33, 0.45);
      transform: translateY(-1px);
      color: #fff;
    }
    
    &:active {
      transform: translateY(1px);
      box-shadow: 0 2px 5px rgba(186, 26, 33, 0.35);
    }
    
    &[disabled] {
      background: #f5f5f5 !important;
      color: #b8b8b8 !important;
      box-shadow: none !important;
      transform: none !important;
      border: 1px solid #d9d9d9 !important;
    }
  }

  &.ant-btn-dangerous {
    background: linear-gradient(135deg, #ff4d4f, #d9363e) !important;
    border: none !important;
    color: #fff !important;
    box-shadow: 0 4px 10px rgba(255, 77, 79, 0.3) !important;

    &:hover, &:focus {
      background: linear-gradient(135deg, #ff7875, #ff4d4f) !important;
      box-shadow: 0 6px 15px rgba(255, 77, 79, 0.4) !important;
      transform: translateY(-1px);
      color: #fff !important;
    }
    
    &:active {
      transform: translateY(1px);
      box-shadow: 0 2px 5px rgba(255, 77, 79, 0.3) !important;
    }
  }

  &.ant-btn-default:not(.ant-btn-dangerous) {
    box-shadow: 0 2px 6px rgba(0,0,0,0.04);
    border-color: #d9d9d9;
    
    &:not([disabled]):hover, &:not([disabled]):focus {
      color: var(--primary-color);
      border-color: var(--primary-color);
      background: rgba(186, 26, 33, 0.04);
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(186, 26, 33, 0.15);
    }
    
    &:active {
      transform: translateY(1px);
    }
  }
}

.btn-premium-edit {
  background: linear-gradient(135deg, #1890ff, #096dd9) !important;
  color: #fff !important;
  border: none !important;
  box-shadow: 0 4px 10px rgba(24, 144, 255, 0.3) !important;
  &:hover, &:focus {
    background: linear-gradient(135deg, #40a9ff, #1890ff) !important;
    box-shadow: 0 6px 15px rgba(24, 144, 255, 0.4) !important;
    transform: translateY(-1px);

export const checkFileSize = (arrFile: any[], fileSize?: number) => {
	let check = true;
	const size = fileSize ?? 8;
	arrFile
		?.filter((item) => item?.remote !== true)
		?.forEach((item) => {
			if (item?.size / 1024 / 1024 > size) {
				check = false;
				message.error(`file ${item?.name} có dung lượng > ${size}Mb`);
			}
		});
	return check;
};


  setDeliveryMethod,
  addresses,
  selectedAddressId,
  setSelectedAddressId,
  onRemoveAddress,
  onAddAddressClick,
  pickupTimeType,
  setPickupTimeType,
  pickupTimeText,
  setPickupTimeText,

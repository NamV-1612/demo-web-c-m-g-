.admin-layout-container {
  min-height: 100vh;

  .admin-sider {
    background: #ffffff;
    box-shadow: 2px 0 8px rgba(0,0,0,0.05);
    z-index: 10;

    .admin-logo {
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 16px;
      border-bottom: 1px solid #f0f0f0;
      color: #BA1A21;
      font-weight: bold;
      font-size: 20px;
      overflow: hidden;
      white-space: nowrap;

      .logo-icon {
        background: #BA1A21;
        color: white;
        border-radius: 50%;
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        margin-right: 8px;
        box-shadow: 0 2px 6px rgba(186, 26, 33, 0.4);
      }
    }

    .admin-menu {
      border-right: none;
      padding-top: 16px;

      .ant-menu-item {
        border-radius: 8px;
        margin: 8px 16px;
        width: calc(100% - 32px);
        color: #595959;
        font-weight: 500;

        &.ant-menu-item-selected {
          background-color: #fff1f0 !important;
          color: #BA1A21 !important;
          
          .anticon {
            color: #BA1A21 !important;
          }

          &::after {
            border-right-color: #BA1A21 !important;
          }
        }

        &:hover {
          color: #BA1A21 !important;
        }
      }
    }
  }

  .admin-header {
    background: #ffffff;
    padding: 0 24px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: 0 1px 4px rgba(0,21,41,0.08);
    z-index: 9;

    .header-left {
      display: flex;
      align-items: center;

      .trigger {
        font-size: 20px;
        cursor: pointer;
        transition: color 0.3s;
        margin-right: 24px;
        color: #595959;

        &:hover {
          color: #BA1A21;
        }
      }

      .header-title {
        margin: 0;
        font-size: 18px;
        font-weight: 600;
        color: #262626;
      }
    }

    .header-right {
      .user-dropdown-link {
        display: flex;
        align-items: center;
        cursor: pointer;
        padding: 0 12px;
        transition: all 0.3s;
        border-radius: 4px;

        &:hover {
          background: #f5f5f5;
        }

        .user-name {
          margin-left: 8px;
          color: #262626;
          font-weight: 500;
        }
      }
    }
  }

  .admin-content {
    margin: 24px 16px;
    padding: 24px;
    background: #ffffff;
    border-radius: 8px;
    box-shadow: 0 1px 2px rgba(0,0,0,0.03);
    min-height: 280px;
  }
}

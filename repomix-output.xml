}

.premium-fire-wrapper:hover {
  transform: translateY(-5px);
  box-shadow: 0 12px 32px rgba(250, 140, 22, 0.5);
}

.premium-fire-wrapper::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  z-index: -1;
  background: conic-gradient(
    transparent 0%, 
    transparent 30%, 
    #ff4d4f 40%, 
    #faad14 48%, 
    #fff 50%,
    transparent 50%, 
    transparent 80%, 
    #ff4d4f 90%, 
    #faad14 98%, 
    #fff 100%
  );
  animation: spinFire 3s linear infinite;
}


}
.icon-pop {
  animation: popIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
  display: inline-block;
}

@keyframes spinFire {
  100% { transform: rotate(360deg); }
}

.premium-fire-wrapper {
  position: relative;
  border-radius: 18px;
  padding: 3px; 
  z-index: 1;
  overflow: hidden;
  box-shadow: 0 8px 24px rgba(250, 140, 22, 0.3);

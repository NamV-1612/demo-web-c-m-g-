	&::after {
		position: absolute;
		bottom: -2px;
		left: 50%;
		width: 0;
		height: 1px;
		background-color: var(--primary-color);
		transform: translateX(-50%);
		opacity: 0;
		transition: 0.3s;
		content: '';
	}

	&:hover::after {
		width: 100%;
		opacity: 1;
		transition: 0.3s;
	}

	&.not-underline::after {
		display: none;
	}
}


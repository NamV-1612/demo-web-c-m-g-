	validate?: TImportRowResponse[];
};

export type TImportRowResponse = {
	index: number;
	rowIndex: number;
	row: { row: number };
	rowErrors?: string[];
};

// EXPORT FIELD

export type TExportField = {
	_id: string;
	label: string;
	fields: string[];
	labels: string[];
	required: boolean;
	type: string;
	children?: TExportField[];
	selected?: boolean;
	disableImport?: boolean;
};
